    },
    "./feedback": {
      "types": "./src/feedback.ts",
      "import": "./src/feedback.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./src/host.ts"
    },
    "./interaction": {
      "types": "./src/interaction.ts",
      "import": "./src/interaction.ts"
    },
    "./link": {
      "types": "./src/link.ts",
      "import": "./src/link.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./style": {
      "types": "./src/style.ts",
      "import": "./src/style.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts"
    },
